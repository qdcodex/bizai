# MongoDB Atlas connection string
MONGODB_URI=

# Google Gemini API key — used server-side only by the AI Assistant, never exposed to the browser
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chat model id (optional — defaults to gemini-3.6-flash)
AI_MODEL=

# Knowledge Base / RAG settings (all optional — sensible defaults apply)
MAX_DOCUMENT_SIZE_MB=20
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.60
RAG_MAX_CONTEXT_CHARS=12000

# Local directory for uploaded document storage (dev default; swap the
# storage service for S3/Vercel Blob/Cloudinary in production)
DOCUMENT_STORAGE_DIR=.data/uploads

# AI Assistant rate limiting (requests per organization per minute)
AI_RATE_LIMIT_PER_MINUTE=20
AI_WRITE_ACTION_RATE_LIMIT_PER_MINUTE=10

# Agentic orchestration guardrails (all optional — sensible defaults apply)
AI_MAX_TOOL_STEPS=8
AI_TOOL_TIMEOUT_MS=10000
AI_MAX_TOOL_RESULT_ITEMS=50
AI_MAX_WORKFLOW_DURATION_MS=30000
AI_MAX_IDENTICAL_TOOL_CALLS=3

# How long a proposed write action (e.g. a quotation preview) stays confirmable
AI_ACTION_EXPIRY_MINUTES=15

# Secret used to sign session JWTs — generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of the app (used for absolute links, e.g. in emails later)
NEXT_PUBLIC_APP_URL=http://localhost:3000
